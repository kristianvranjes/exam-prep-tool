# Copy to deploy/vm/.env on the VM (`cp .env.example .env && chmod 600 .env`)
# and fill in every value. Never commit the real file.

# --- Caddy / HTTPS ---------------------------------------------------------
# A DNS name that points at the VM's public IP, e.g. a free DuckDNS subdomain.
SITE_ADDRESS=examprep-api.duckdns.org
# Your e-mail for Let's Encrypt notices.
ACME_EMAIL=you@example.com

# --- Backend ---------------------------------------------------------------
APP_ENV=production
# The Vercel site, exactly one HTTPS origin without a trailing slash.
FRONTEND_URL=https://exam-prep-tool-gamma.vercel.app
# Neon -> Connect -> pooling OFF (direct connection), keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# Vercel and the VM are different sites, so cookies must be SameSite=None.
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_NAME=examprep_session
SESSION_MAX_AGE_SECONDS=14400

# AI generation stays off on this VM; question import works without it.
AI_PROVIDER=disabled
AI_REQUEST_TIMEOUT_SECONDS=120
# To enable generation instead, set AI_PROVIDER=openai_compatible and:
# OPENAI_COMPATIBLE_URL=https://provider.example/v1
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_API_KEY=
