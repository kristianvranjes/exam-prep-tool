APP_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://examprep:examprep@localhost:5432/examprep
POSTGRES_USER=examprep
POSTGRES_PASSWORD=examprep
POSTGRES_DB=examprep
JWT_SECRET=replace-before-future-authentication
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
AI_PROVIDER=ollama
# Optional development gateway; install/configure separately. No automatic fallback.
FREELLMAPI_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_DOCKER_URL=http://host.docker.internal:3001/v1
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=12000
AI_CONCEPT_CHUNKS_PER_REQUEST=3
AI_MAX_BATCHES=32
# Compose reaches the host through this URL; native backend uses OLLAMA_URL above.
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_NAME=examprep_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Staging: explicit HTTPS /v1 service with JSON-object chat completions support.
# Never put the key into a NEXT_PUBLIC variable. No automatic provider fallback.
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
MATERIAL_STORAGE_DIR=./data/materials
MATERIAL_MAX_UPLOAD_BYTES=20971520
MATERIAL_CHUNK_TARGET_CHARS=2500
MATERIAL_CHUNK_OVERLAP_CHARS=250

# Separate local embedding provider; optional ML extra and predownloaded model required.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_MAX_TOKENS=8192
EMBEDDING_BATCH_SIZE=4
EMBEDDING_BATCH_CHARS=12000
EMBEDDING_MAX_CHUNKS=128
EMBEDDING_MAX_TEXT_CHARS=6000

# Question generation bounds; can be lowered, never raised above these maxima.
QUESTION_GENERATION_MAX_COUNT=10
QUESTION_GENERATION_MAX_CONCEPTS=5
QUESTION_GENERATION_RETRIEVAL_TOP_K_MAX=10
QUESTION_GENERATION_MAX_CONTEXT_CHUNKS=12
QUESTION_GENERATION_MAX_CONTEXT_CHARS=16000

# External quiz import limits; may be lowered, not raised. AI_PROVIDER=disabled needs no AI keys.
QUESTION_IMPORT_MAX_BYTES=262144
QUESTION_IMPORT_MAX_COUNT=50
